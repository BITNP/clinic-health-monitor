# Copy this file to .env, then fill in MAINTAINER_QQ_IDS,
# MESSAGE_GATEWAY_ACCOUNT, and MESSAGE_GATEWAY_ACCOUNT_TOKEN.
# Keep .env out of version control: chmod 600 .env.

# ── Health target ─────────────────────────────────────────────────────────
# Backend endpoint polled by the monitor. Use the compose service name when the
# monitor runs inside the clinic network, or 127.0.0.1 for a host-run binary.
MONITOR_TARGET_URL=http://backend:8080/healthz
# Name used in alert messages.
MONITOR_TARGET_NAME=clinic-backend

# Optional admin frontend target. Uncomment both lines to enable it. Leave
# them commented out to monitor only the backend.
# MONITOR_FRONTEND_URL=http://admin-frontend:80/
# MONITOR_FRONTEND_NAME=clinic-admin-frontend

# ── Check schedule ────────────────────────────────────────────────────────
# Time between checks.
MONITOR_INTERVAL=30s
# Per-check HTTP timeout. Keep it shorter than MONITOR_INTERVAL.
MONITOR_TIMEOUT=5s
# Consecutive failures before an outage alert is sent.
MONITOR_FAILURE_THRESHOLD=3
# Consecutive successes before the target is considered recovered.
MONITOR_RECOVERY_THRESHOLD=1
# Repeat an alert while the target stays down. 0s disables repeats.
MONITOR_ALERT_REPEAT_INTERVAL=0s
# Send a recovery message after an outage alert.
MONITOR_NOTIFY_RECOVERY=true

# ── Monitor liveness ──────────────────────────────────────────────────────
# Internal liveness endpoint. It never reports the target backend's health.
MONITOR_HTTP_ADDR=:8082
# Instance name included in messages.
MONITOR_INSTANCE_NAME=clinic-health-monitor

# ── Maintainers and message-gateway ───────────────────────────────────────
# Comma-separated QQ user ids. At least one id is required.
MAINTAINER_QQ_IDS=10001,10002
# The gateway HTTP API. Use http://127.0.0.1:8081 for a host-run binary.
MESSAGE_GATEWAY_URL=http://message-gateway:8081
# Gateway account whose client_token the monitor uses for alerts.
MESSAGE_GATEWAY_ACCOUNT=qq
# The client_token configured for that account in message-gateway/accounts.json.
MESSAGE_GATEWAY_ACCOUNT_TOKEN=
MESSAGE_GATEWAY_TIMEOUT=5s

# ── Standalone Compose stack ──────────────────────────────────────────────
# The production deployment uses clinic-backend/docker-compose.prod.yml.
HEALTH_MONITOR_IMAGE_TAG=latest
HEALTH_MONITOR_PORT=8082
CLINIC_BACKEND_NETWORK=clinic-backend_default
MESSAGE_GATEWAY_NETWORK=message-gateway

# Container-local timezone used in message timestamps.
TZ=Asia/Shanghai
